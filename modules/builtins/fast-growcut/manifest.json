{
  "id": "org.xnat.builtins.fast-growcut",
  "name": "Fast GrowCut (module)",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "runtime": "wasm-worker",
  "publisher": "XNAT Workstation",
  "license": "MIT",
  "description": "The built-in Seeded segmentation's Fast GrowCut, packaged as a module from the same solver: grows the active segment from its seeds against every other seed (other segments, Background). Proves API 1.0 can express a real Workstation operation.",
  "entry": "module.js",
  "params": [
    { "key": "gateOn", "label": "Intensity gate", "kind": "boolean", "default": false, "hint": "Only grow into voxels inside the window" },
    { "key": "gateLo", "label": "Gate from", "kind": "number", "min": -1000, "max": 3000, "step": 10, "default": -150 },
    { "key": "gateHi", "label": "Gate to", "kind": "number", "min": -1000, "max": 3000, "step": 10, "default": 250 },
    { "key": "postOn", "label": "Clean up the result", "kind": "boolean", "default": false, "advanced": true },
    { "key": "postKeep", "label": "Keep component", "kind": "select", "default": "seed", "advanced": true,
      "options": [{ "value": "off", "label": "All" }, { "value": "seed", "label": "Touching a seed" }, { "value": "largest", "label": "Largest" }] },
    { "key": "postMinIsland", "label": "Remove islands below", "kind": "number", "min": 0, "max": 5000, "step": 10, "default": 300, "unit": "voxels", "advanced": true },
    { "key": "postSmooth", "label": "Smoothing passes", "kind": "number", "min": 0, "max": 5, "step": 1, "default": 1, "advanced": true },
    { "key": "postShrinkGrow", "label": "Shrink–grow passes", "kind": "number", "min": 0, "max": 5, "step": 1, "default": 1, "advanced": true }
  ],
  "reads": { "image": true, "members": "none", "seeds": true },
  "writes": { "target": "active", "mode": "add" },
  "scopes": ["volume", "range", "roi"],
  "bytesPerVoxel": 16
}
