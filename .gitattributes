# Track large/binary E2E DICOM fixtures via Git LFS so the main repo stays light.
# See e2e/fixtures/dicom/README.md for the fixture-loading harness.
e2e/fixtures/dicom/**/*.dcm filter=lfs diff=lfs merge=lfs -text
e2e/fixtures/dicom/**/*.ima filter=lfs diff=lfs merge=lfs -text
e2e/fixtures/dicom/**/*.img filter=lfs diff=lfs merge=lfs -text
